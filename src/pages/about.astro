---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";

// Stage 1 stub — the full About page is built in a later stage.
---

<BaseLayout
  title="About · Argensonix"
  description="Argensonix is the personal digital lab of Nicolás Zicarelli — design, web, radio, writing and tools. Buenos Aires, since 1999."
>
  <Header activePage="about" />

  <main id="main-content" class="page theme-light">
    <div class="container page__intro section">
      <EyebrowLabel text="About" theme="light" />
      <h1 class="page__title">Design, curiosity and craft.</h1>
      <p class="page__lead lead">
        Argensonix is a personal digital lab — web, radio, writing and tools,
        built slowly and for real use since 1999.
      </p>
      <p class="page__note">Full page coming in a later stage.</p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    min-height: 55vh;
  }

  .page__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    max-width: 16ch;
  }

  .page__note {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
